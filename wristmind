#!/usr/bin/env sh
# WristMind installer and server management entry point.
#
#   ./wristmind              state-aware menu (install or manage)
#   ./wristmind install      install, or reconcile an existing install
#   ./wristmind check        check requirements (Docker, RAM, disk, port)
#   ./wristmind status       print detected state and access addresses
#   ./wristmind version      print the version of this checkout
#
# Flags for automation:
#   ./wristmind install --domain=example.com --yes
#   ./wristmind install --public-url=http://10.0.0.5:8080 --yes
#
# POSIX sh. Every action is idempotent: running it twice never reinstalls or
# destroys data. The wizard paints a plan; unsupported menu items say so
# instead of pretending.

set -eu

WM_ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
WM_SERVER_DIR="$WM_ROOT/server"
WM_DEPLOY_DIR="$WM_SERVER_DIR/deploy"

if [ ! -f "$WM_DEPLOY_DIR/install.sh" ] || [ ! -f "$WM_DEPLOY_DIR/env.sh" ]; then
    echo "ошибка: не найден server/deploy — запустите wristmind из корня репозитория." >&2
    exit 1
fi

# shellcheck source=server/deploy/env.sh
. "$WM_DEPLOY_DIR/env.sh"
# shellcheck source=server/deploy/install.sh
. "$WM_DEPLOY_DIR/install.sh"

# ---------------------------------------------------------------------------
# Small UI helpers
# ---------------------------------------------------------------------------
wm_hr() { printf '%s\n' '────────────────────────────────────────────'; }

wm_header() {
    printf 'WristMind · %s' "${1:-меню}"
    _wm_v="$(wm_version_label "$WM_ROOT")"
    printf '%*s%s\n' 0 '' "  ($_wm_v)"
}

wm_menu_item() {
    printf '  %s) %s\n' "${1}" "${2}"
}

wm_not_implemented() {
    printf '\n%s\n' "«$1» ещё не реализовано."
    printf '%s\n' "Это запланированный шаг, а не ошибка. Текущее состояние: docs/SELF_HOSTING_STATUS.md."
    return 0
}

wm_prompt() {
    printf '\nВыбор: '
}

# State summary printed above both menus.
wm_state_summary() {
    _wm_state="$(wm_state "$WM_ROOT")"
    _wm_server="$WM_SERVER_DIR"
    _wm_port="$(wm_http_port "$_wm_server")"

    printf '\n'
    case "$_wm_state" in
        installed)
            printf '  Сервер:   работает\n'
            ;;
        configured)
            printf '  Сервер:   настроен, контейнеры не запущены\n'
            ;;
        *)
            printf '  Сервер:   не установлен\n'
            ;;
    esac
    printf '  Порт:     %s\n' "$_wm_port"
    if [ -n "${WRISTMIND_PUBLIC_BASE_URL:-}" ]; then
        printf '  Адрес:    %s\n' "$WRISTMIND_PUBLIC_BASE_URL"
    fi
}

# ---------------------------------------------------------------------------
# Clean machine
# ---------------------------------------------------------------------------
wm_install_menu() {
    wm_header "установка"
    printf '\nСервер пока не установлен.\n'
    wm_state_summary
    printf '\n'
    wm_menu_item 1 "Установить"
    wm_menu_item 2 "Проверить требования (Docker, память, порты)"
    wm_menu_item 3 "Что это и что понадобится"
    wm_menu_item 0 "Выход"
    wm_prompt
}

wm_what_is_this() {
    printf '\n%s\n' 'WristMind — ассистент на часах Wear OS.'
    printf '%s\n' 'Голосовой чат, режимы и свои базы знаний. Данные остаются у владельца.'
    printf '\n%s\n' 'Понадобится:'
    printf '%s\n' '  - часы Wear OS (Xiaomi Watch 2 проверены);'
    printf '%s\n' '  - сервер или VPS: 2 vCPU, 4 ГБ RAM, 10 ГБ диска;'
    printf '%s\n' '  - домен: без HTTPS часы не подключатся;'
    printf '%s\n' '  - ключ провайдера модели: OpenRouter или DeepSeek; оплата на владельце;'
    printf '%s\n' '  - Wi-Fi, где на момент установки телефон и часы в одной сети.'
    printf '\n%s\n' 'Не нужно: Google Play, аккаунты сторонних сервисов, VPN, ручной adb с ноутбука.'
    printf '\n%s\n' 'Для первого запуска без сервера: docker compose up на ноутбуке с моками.'
}

wm_do_install() {
    printf '\n'
    if wm_install "$WM_ROOT" "$@"; then
        return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------
# Already installed
# ---------------------------------------------------------------------------
wm_manage_menu() {
    wm_header "управление"
    wm_state_summary
    printf '\n'
    wm_menu_item 1 "Обновить до последней версии"
    wm_menu_item 2 "Проверить состояние (здоровье, логи, порты)"
    wm_menu_item 3 "Домен и HTTPS        → добавить / сменить / продлить"
    wm_menu_item 4 "Ключи и провайдеры   → ключ модели, поиск, Telegram"
    wm_menu_item 5 "Резервные копии      → создать / скачать / восстановить"
    wm_menu_item 6 "Перезапустить"
    wm_menu_item 7 "Остановить"
    wm_menu_item 8 "Удалить установку"
    wm_menu_item 9 "Показать доступы (панель, API, коды подключения)"
    wm_menu_item 0 "Выход"
    wm_prompt
}

wm_manage_health() {
    _wm_port="$(wm_http_port "$WM_SERVER_DIR")"
    printf '\n'
    if wm_http_ok "http://127.0.0.1:${_wm_port}/health"; then
        wm_ok "API отвечает на http://127.0.0.1:${_wm_port}/health"
    else
        wm_err "API не отвечает на http://127.0.0.1:${_wm_port}/health"
    fi
    if wm_have_compose; then
        printf '\n%s\n' 'Контейнеры:'
        wm_compose "$WM_SERVER_DIR" ps 2>&1 | sed 's/^/  /'
    fi
}

wm_manage_restart() {
    printf '\n'
    if wm_compose_log "$WM_SERVER_DIR" restart; then
        wm_ok "контейнеры перезапущены"
    else
        wm_err "не удалось перезапустить контейнеры"
        return 1
    fi
}

wm_manage_stop() {
    printf '\n'
    if wm_compose_log "$WM_SERVER_DIR" stop; then
        wm_ok "контейнеры остановлены, тома с данными не тронуты"
    else
        wm_err "не удалось остановить контейнеры"
        return 1
    fi
}

wm_manage_access() {
    _wm_port="$(wm_http_port "$WM_SERVER_DIR")"
    wm_access_block "$WM_ROOT" "http://127.0.0.1:${_wm_port}"
}

wm_manage_menu_loop() {
    _wm_again=1
    while [ "$_wm_again" -eq 1 ]; do
        wm_manage_menu
        if ! IFS= read -r _wm_choice; then
            printf '\n'
            return 0
        fi
        _wm_again=0
        case "$_wm_choice" in
            1) wm_not_implemented "Обновить до последней версии" ;;
            2) wm_manage_health ;;
            3) wm_not_implemented "Домен и HTTPS" ;;
            4) wm_not_implemented "Ключи и провайдеры" ;;
            5) wm_not_implemented "Резервные копии" ;;
            6) wm_manage_restart ;;
            7) wm_manage_stop ;;
            8) wm_not_implemented "Удалить установку" ;;
            9) wm_manage_access ;;
            0 | q | Q | "") return 0 ;;
            *) printf '\nНеизвестный пункт: %s\n' "$_wm_choice" ;;
        esac
        _wm_again=1
    done
}

wm_install_menu_loop() {
    _wm_again=1
    while [ "$_wm_again" -eq 1 ]; do
        wm_install_menu
        if ! IFS= read -r _wm_choice; then
            printf '\n'
            return 0
        fi
        _wm_again=0
        case "$_wm_choice" in
            1)
                if wm_do_install; then
                    return 0
                fi
                return 1
                ;;
            2)
                printf '\n%s\n' 'Проверка требований:'
                wm_requirements "$WM_ROOT" || true
                ;;
            3) wm_what_is_this ;;
            0 | q | Q | "") return 0 ;;
            *) printf '\nНеизвестный пункт: %s\n' "$_wm_choice" ;;
        esac
        _wm_again=1
    done
}

# ---------------------------------------------------------------------------
# Command dispatch
# ---------------------------------------------------------------------------
wm_cmd_install() {
    shift
    _wm_yes=0
    _wm_args=""
    for _wm_arg in "$@"; do
        case "$_wm_arg" in
            --yes | -y) _wm_yes=1 ;;
            *) _wm_args="$_wm_args $_wm_arg" ;;
        esac
    done
    # shellcheck disable=SC2086
    wm_install "$WM_ROOT" $_wm_args
}

wm_cmd_check() {
    printf 'Проверка требований:\n'
    wm_requirements "$WM_ROOT"
}

wm_cmd_status() {
    _wm_state="$(wm_state "$WM_ROOT")"
    printf 'Состояние: %s\n' "$_wm_state"
    printf 'Версия:    %s\n' "$(wm_version_label "$WM_ROOT")"
    printf 'Порт:      %s\n' "$(wm_http_port "$WM_SERVER_DIR")"
    printf '.env:      %s\n' "$(wm_env_file "$WM_SERVER_DIR")"
}

wm_cmd_help() {
    cat <<'EOF'
WristMind — установка и управление сервером.

  ./wristmind                     меню по состоянию машины
  ./wristmind install             установить или согласовать установку
  ./wristmind install --domain=example.com --yes
  ./wristmind install --public-url=http://10.0.0.5:8080 --yes
  ./wristmind check               проверить требования
  ./wristmind status              показать определённое состояние
  ./wristmind version             версия этого чекаута

Повторный запуск ничего не ломает и не переустанавливает.
EOF
}

wm_main() {
    _wm_cmd="${1:-menu}"
    case "$_wm_cmd" in
        menu | "")
            _wm_state="$(wm_state "$WM_ROOT")"
            if [ "$_wm_state" = "empty" ]; then
                wm_install_menu_loop
            else
                wm_manage_menu_loop
            fi
            ;;
        install) wm_cmd_install "$@" ;;
        check) wm_cmd_check ;;
        status) wm_cmd_status ;;
        version) printf '%s\n' "$(wm_version_label "$WM_ROOT")" ;;
        help | --help | -h) wm_cmd_help ;;
        *)
            wm_err "неизвестная команда: $_wm_cmd"
            wm_cmd_help >&2
            return 1
            ;;
    esac
}

wm_main "$@"
