# WristMind environment template.
#
# `./wristmind` copies this file to `.env` and replaces every
# `generate-a-long-random-value` placeholder with a real secret. Do not commit
# the resulting `.env`; it is ignored by Git.
#
# Only POSTGRES_PASSWORD is required by `compose.yaml`. Everything below has a
# working default for a local, mock-provider install.

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=generate-a-long-random-value

# --- Core -------------------------------------------------------------------
WRISTMIND_ENVIRONMENT=production
WRISTMIND_BOOTSTRAP_SECRET=generate-a-long-random-value
WRISTMIND_TOKEN_PEPPER=generate-a-long-random-value
WRISTMIND_FALLBACK_TICKET_SECRET=generate-a-long-random-value
# Public address of this installation, used for enrollment and links.
# For a bare-IP install use http://<ip>; watches additionally require HTTPS.
WRISTMIND_PUBLIC_BASE_URL=http://127.0.0.1
WRISTMIND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Model providers --------------------------------------------------------
# Mocks are on until real keys are set, so a first install answers without
# spending money. Set WRISTMIND_MOCK_PROVIDERS=false after adding a key.
WRISTMIND_MOCK_PROVIDERS=true
WRISTMIND_OPENROUTER_API_KEY=
WRISTMIND_DEEPSEEK_API_KEY=
WRISTMIND_DEEPSEEK_REASONING_EFFORT=low
WRISTMIND_GIGACHAT_CREDENTIALS=
WRISTMIND_GIGACHAT_VERIFY_SSL=false

# --- Retrieval --------------------------------------------------------------
WRISTMIND_FULL_CONTEXT_THRESHOLD_TOKENS=12000
WRISTMIND_RETRIEVAL_CONTEXT_BUDGET_TOKENS=6000

# --- Optional: private web search (enables the `search` profile) ------------
# SEARXNG_SECRET=generate-a-long-random-value
# WRISTMIND_SEARXNG_URL=http://searxng:8080

# --- Optional: Telegram notifications (enables the `telegram` profile) ------
# WRISTMIND_TELEGRAM_BOT_TOKEN=
# WRISTMIND_TELEGRAM_OWNER_ID=

# --- Optional: reverse SSH tunnel (enables the `public-gateway` profile) ----
# WRISTMIND_TUNNEL_HOST=
# WRISTMIND_TUNNEL_PORT=22
# WRISTMIND_TUNNEL_USER=root
# WRISTMIND_TUNNEL_REMOTE_PORT=18080

# --- Optional: custom host paths for mounted files --------------------------
# Firebase push key for the watch. Missing file is fine; push is then disabled.
# WRISTMIND_FIREBASE_KEY_PATH=./secrets/firebase-admin.json
# WRISTMIND_TUNNEL_KEY_PATH=./secrets/vps-tunnel-key

# --- Latency diagnostics (diagnostic-only; never changes answers) ------------
# JSONL trace is written to <WRISTMIND_STORAGE_DIR>/latency-trace.jsonl.
WRISTMIND_LATENCY_TRACE_ENABLED=true
# Live Telegram feed. Off by default; both names are accepted.
LATENCY_TELEGRAM_ENABLED=false
# Optional dedicated diagnostics bot. Unset = WRISTMIND_TELEGRAM_BOT_TOKEN.
WRISTMIND_LATENCY_TELEGRAM_BOT_TOKEN=
# Optional explicit chat id. Unset = WRISTMIND_TELEGRAM_OWNER_ID.
WRISTMIND_LATENCY_TELEGRAM_CHAT_ID=
WRISTMIND_LATENCY_TRACE_MAX_BYTES=8000000
WRISTMIND_LATENCY_TRACE_BACKUP_COUNT=5
