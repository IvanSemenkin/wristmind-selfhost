[Unit]
Description=WristMind DeepSeek fallback API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wristmind
Group=wristmind
WorkingDirectory=/opt/wristmind-fallback/server
EnvironmentFile=/etc/wristmind/fallback.env
Environment=PYTHONPATH=/opt/wristmind-fallback/server/src
Environment=WRISTMIND_FALLBACK_DATABASE_PATH=/var/lib/wristmind-fallback/fallback.sqlite3
ExecStart=/opt/wristmind-fallback/venv/bin/python -m wristmind_server.fallback_app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=wristmind-fallback
ReadWritePaths=/var/lib/wristmind-fallback

[Install]
WantedBy=multi-user.target
