# Template only. Stage 3 will generate fresh secrets for each installation.
# Use hexadecimal secrets (the PostgreSQL password is part of a database URL).
POSTGRES_PASSWORD=
WRISTMIND_BOOTSTRAP_SECRET=
WRISTMIND_TOKEN_PEPPER=

WRISTMIND_PROJECT_NAME=wristmind-selfhost
WRISTMIND_HTTP_PORT=8080
# Loopback is intentional until HTTPS/access setup are ready.
# Use 0.0.0.0 only when knowingly exposing the panel to your LAN/server network.
WRISTMIND_BIND_ADDRESS=127.0.0.1
WRISTMIND_PUBLIC_BASE_URL=http://localhost:8080
WRISTMIND_CORS_ORIGINS=[]
WRISTMIND_MOCK_PROVIDERS=false
WRISTMIND_OPENROUTER_API_KEY=
WRISTMIND_DEEPSEEK_API_KEY=

# Search is configured automatically by install; existing installations: wristmind web-search.
COMPOSE_PROFILES=search
WRISTMIND_SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=

# Optional Telegram: enable profile telegram and provide the bot settings.
# WRISTMIND_TELEGRAM_BOT_TOKEN=
# WRISTMIND_TELEGRAM_OWNER_ID=

# Optional local models: ./wristmind local-model --role embedding
# Image override is configured in the terminal; local-ai has no public ports.
WRISTMIND_OLLAMA_IMAGE=ollama/ollama:latest
